# ======================
# RentAI Environment Variables
# ======================

# AI Provider
AI_PROVIDER=deepseek                    # deepseek | openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# Voice Provider
VOICE_PROVIDER=google                   # google | yandex | openai
GOOGLE_TTS_KEY=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/rentai

# Auth (JWT + httpOnly cookies: access_token, refresh_token; Path=/api)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set true on API host when the browser app is on another origin (e.g. Vercel admin → Render API) so httpOnly JWT cookies use SameSite=None; also add the app URL to CORS_ORIGINS.
AUTH_COOKIE_CROSS_SITE=false

# Storage
STORAGE_PROVIDER=local                  # local | s3
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Public API base (no trailing slash). Used in logs for Telegram webhook URL; set on dev when using ngrok/cloudflared.
# API_PUBLIC_URL=https://abc123.trycloudflare.com

# Telegram Bot (optional — escalation alerts to managers)
# Create a bot via @BotFather, then:
# 1. Set webhook: POST https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/v1/telegram/webhook&secret_token=<SECRET>
# 2. Get the manager's chat_id via @userinfobot or first message to bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Zodomus (channel manager API) — optional
ZODOMUS_ENABLED=false
# ZODOMUS_API_USER=
# ZODOMUS_API_PASSWORD=
ZODOMUS_BASE_URL=https://api.zodomus.com
# Optional: doc/zodomus/fetch-samples.mjs — sandbox property id from Zodomus backoffice
# ZODOMUS_SAMPLE_PROPERTY_ID=
# ZODOMUS_SAMPLE_CHANNEL_ID=1
# ZODOMUS_RUN_ACTIVATION=false
# ZODOMUS_PRICE_MODEL_ID=   # required for POST /property-activation (Zodomus backoffice / API)
# ZODOMUS_ROOMS_ACTIVATION_JSON=doc/zodomus/rooms-activation.example.json
# полный пример (roomName, quantity, status, rates[]): doc/zodomus/rooms-activation.mapped-products.example.json
# ZODOMUS_CREATE_TEST_RESERVATION=false
# ZODOMUS_CREATE_TEST_STATUS=new   # new | modified | cancelled | summary
# ZODOMUS_CREATE_TEST_RESERVATION_ID=   # optional — POST /reservations-createtest body.reservationId (Zodomus API)
# ZODOMUS_FETCH_RESERVATION_SAMPLE=true   # fetch-samples.mjs: GET /reservations for first queue id → doc/zodomus/response-reservation.json
# ZODOMUS_API_PASSWORD_CC=   # PCI card endpoints only
# Webhook key from Zodomus backoffice → Development → Webhook Key (validates incoming POST /webhook)
# ZODOMUS_WEBHOOK_KEY=
# Cron polling interval minutes (backup to webhook), default 15
# ZODOMUS_POLL_INTERVAL_MINUTES=15
# Default channelId for cron polling (1 = Booking.com)
# ZODOMUS_DEFAULT_CHANNEL_ID=1
# Push local calendar occupancy to Zodomus after booking/iCal/sync changes (default true)
# ZODOMUS_AUTO_PUSH_AVAILABILITY=true
# Nights to cover on POST /availability (default 366, max 730)
# ZODOMUS_AVAILABILITY_HORIZON_DAYS=366
# Debounce rapid booking edits into one push per property (ms, 0 = off)
# ZODOMUS_AVAILABILITY_PUSH_DEBOUNCE_MS=2000
# Retry properties after failed push (minutes)
# ZODOMUS_AVAILABILITY_DIRTY_RETRY_MINUTES=15
# Nightly full availability push for drift (true/false)
# ZODOMUS_AVAILABILITY_NIGHTLY_FULL_PUSH=true
# UTC hour for nightly push (0–23)
# ZODOMUS_AVAILABILITY_NIGHTLY_HOUR_UTC=3
# Delay between properties in batch jobs (ms)
# ZODOMUS_AVAILABILITY_BATCH_GAP_MS=1000
# Delay between GET /reservations when draining the queue (ms; reduces API burst errors)
# ZODOMUS_QUEUE_ITEM_DELAY_MS=400
# Per-request timeout to Zodomus (ms); each retry resets the timer. Default 8000.
# ZODOMUS_FETCH_TIMEOUT_MS=8000

# iCal sync polling interval in minutes (default 60)
# ICAL_POLL_INTERVAL_MINUTES=60

# Resend inbound email + replies (optional — set to enable POST /api/v1/webhooks/resend and outbound replies)
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=          # Svix secret; omit in dev to skip signature verification
# RESEND_FROM_EMAIL=              # Address Resend accepts for "from". Your *.resend.app subdomain must still be verified under Domains (until then, API returns "domain is not verified"). For quick tests without domain setup use: onboarding@resend.dev
# RESEND_INBOUND_DOMAIN=
# RESEND_DEFAULT_OWNER_ID=        # UUID of users.id — owner for inbound mail when routing is not mapped
# RESEND_INBOUND_PROPERTY_ID=     # Optional: which property’s inbox to use for email→chat; default = owner’s first property
# REDIS_URL=redis://localhost:6379   # If set: BullMQ for Telegram escalation delivery + async Resend inbound (dedup then queue). If unset, inbound email is processed synchronously in the webhook handler.

# Feature Flags
FF_VOICE_ENABLED=false
FF_REALTIME_CALLS_ENABLED=false

# App
 

# App
NODE_ENV=development
API_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3010
# Socket.IO: browser connects to the Nest origin (NEXT_PUBLIC_API_URL). Next.js HTTP proxy cannot upgrade WebSockets.
# Auth: short-lived token from POST /api/v1/auth/ws-token (via Next proxy) in the Socket.IO handshake.
# Optional NEXT_PUBLIC_WS_URL if the WS origin must differ from NEXT_PUBLIC_API_URL.
# Nest normalizes `/api/socket.io?…` → `/api/socket.io/?…` (backend/src/main.ts).
PORT=3010
# Dual-stack (IPv4+IPv6). `localhost` in cloudflared resolves to [::1] on Windows — use :: here, or keep 0.0.0.0 and set tunnel origin to http://127.0.0.1:3010
HOST=::
NEXT_PUBLIC_SITE_URL=http://localhost:3012
# Show guest-simulator UI on /chat in production builds (staging). In dev it is on by default.
# NEXT_PUBLIC_ENABLE_GUEST_SIMULATOR=true
CORS_ORIGINS=http://localhost:3012,http://localhost:3011,http://localhost:3013
