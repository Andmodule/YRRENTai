# ======================
# RentAI Environment Variables
# ======================

# AI Provider
AI_PROVIDER=deepseek                    # deepseek | openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# Voice Provider
VOICE_PROVIDER=google                   # google | yandex | openai
GOOGLE_TTS_KEY=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/rentai

# Auth (JWT + httpOnly cookies: access_token, refresh_token; Path=/api)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local                  # local | s3
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Telegram Bot (optional — escalation alerts to managers)
# Create a bot via @BotFather, then:
# 1. Set webhook: POST https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/v1/telegram/webhook&secret_token=<SECRET>
# 2. Get the manager's chat_id via @userinfobot or first message to bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Feature Flags
FF_VOICE_ENABLED=false
FF_REALTIME_CALLS_ENABLED=false

# App
 

# App
NODE_ENV=development
API_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_WS_URL=ws://localhost:3010
PORT=3010
NEXT_PUBLIC_SITE_URL=http://localhost:3012
CORS_ORIGINS=http://localhost:3012,http://localhost:3011
