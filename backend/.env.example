# AI Provider
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# Voice Provider
VOICE_PROVIDER=google
GOOGLE_TTS_KEY=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/rentai

# Auth (JWT)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Zodomus (optional)
ZODOMUS_ENABLED=false
# ZODOMUS_API_USER=
# ZODOMUS_API_PASSWORD=
ZODOMUS_BASE_URL=https://api.zodomus.com

# Feature Flags
FF_VOICE_ENABLED=false
FF_REALTIME_CALLS_ENABLED=false

# App
NODE_ENV=development
PORT=3000
# Include Staff PWA origin if the app calls the API directly (NEXT_PUBLIC_API_URL=http://localhost:<API_PORT>)
CORS_ORIGINS=http://localhost:3001,http://localhost:3012,http://localhost:3013
