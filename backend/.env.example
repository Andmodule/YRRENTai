# AI Provider
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# Voice: Groq STT (whisper-large-v3) + DeepSeek JSON — используется для:
#   POST /tasks/voice-parse (менеджер), POST /tasks/staff-miniapp/voice-preview (персонал)
GROQ_API_KEY=
VOICE_PARSE_GROQ_WHISPER_MODEL=whisper-large-v3
# Optional: OpenAI-compatible STT override (not used by default pipeline)
# VOICE_PARSE_STT_BASE_URL=
# VOICE_PARSE_STT_API_KEY=

# Voice Provider
VOICE_PROVIDER=google
GOOGLE_TTS_KEY=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/rentai

# Auth (JWT)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Self-service sign-up (set false in production for invite-only tenants)
AUTH_PUBLIC_REGISTRATION_ENABLED=true

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Zodomus (optional)
ZODOMUS_ENABLED=false
# ZODOMUS_API_USER=
# ZODOMUS_API_PASSWORD=
ZODOMUS_BASE_URL=https://api.zodomus.com
# Same string as Zodomus backoffice → Webhook Key (validates POST /api/v1/integrations/zodomus/webhook)
# ZODOMUS_WEBHOOK_KEY=
# ZODOMUS_DEFAULT_CHANNEL_ID=1
# ZODOMUS_AUTO_PUSH_AVAILABILITY=true
# ZODOMUS_AVAILABILITY_HORIZON_DAYS=366
# ZODOMUS_AVAILABILITY_PUSH_DEBOUNCE_MS=2000
# ZODOMUS_AVAILABILITY_DIRTY_RETRY_MINUTES=15
# ZODOMUS_AVAILABILITY_NIGHTLY_FULL_PUSH=true
# ZODOMUS_AVAILABILITY_NIGHTLY_HOUR_UTC=3
# ZODOMUS_AVAILABILITY_BATCH_GAP_MS=1000
# ZODOMUS_QUEUE_ITEM_DELAY_MS=400

# «Цены → Скидки» (Booking promotions via Zodomus) — see doc/zodomus/PROMOTIONS.md
# Off by default. Writes to Booking need BOTH enabled=true AND dry_run=false.
# ZODOMUS_PROMOTIONS_ENABLED=false
# ZODOMUS_PROMOTIONS_DRY_RUN=true
# Pilot: comma-separated RentAI property UUIDs allowed to receive writes (empty = all)
# ZODOMUS_PROMOTIONS_PROPERTY_ALLOWLIST=
# ZODOMUS_PROMOTIONS_CHANNEL_ID=1
# ZODOMUS_PROMOTIONS_SYNC_MINUTES=30
# ZODOMUS_PROMOTIONS_QUEUE_INTERVAL_SECONDS=60
# ZODOMUS_PROMOTIONS_GAP_MS=2000
# ZODOMUS_PROMOTIONS_VERIFY=true

# Feature Flags
FF_VOICE_ENABLED=false
FF_REALTIME_CALLS_ENABLED=false

# Telegram — main bot (client/manager): webhook /api/v1/telegram/webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Telegram — staff bot: webhook /api/v1/telegram/staff-webhook
# TELEGRAM_STAFF_BOT_TOKEN=
# TELEGRAM_STAFF_BOT_USERNAME=
# TELEGRAM_STAFF_WEBHOOK_SECRET=
# Staff Mini App (frontend-staff), HTTPS root — основной URL для кнопок бота и уведомлений.
# TELEGRAM_STAFF_MINI_APP_URL=https://staff.your-app.example.com
# Legacy manager TMA (frontend-user /ru/tma/tasks) — не подставляйте как основной staff URL.
# TELEGRAM_MINI_APP_URL=https://your-app.example.com/ru/tma/tasks
# Manager dashboard (HTTPS) for incident Telegram button: .../dashboard + /incidents?incident=<uuid>
# MANAGER_WEB_APP_URL=https://your-app.example.com/ru/dashboard

# App
NODE_ENV=development
PORT=3000
# Include Staff PWA origin if the app calls the API directly (NEXT_PUBLIC_API_URL=http://localhost:<API_PORT>)
CORS_ORIGINS=http://localhost:3001,http://localhost:3012,http://localhost:3013

# Resend — inbound email → chat (POST /api/v1/webhooks/resend) and staff replies → guest email
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@yourdomain.com   # verified sender in Resend
# RESEND_WEBHOOK_SECRET=                           # Svix secret from Resend inbound webhook (required in prod)
# RESEND_DEFAULT_OWNER_ID=                         # UUID of the owner user (tenant) for inbound routing
# RESEND_INBOUND_PROPERTY_ID=                      # optional: direct-email inbox only; OTA uses linked hotel/reservation, no fallback
# INBOUND_EMAIL_AI_AUTO_REPLY_ENABLED=true         # false = no LLM / no auto email to guest on inbound (guest msg + inbox still); staff replies unchanged
# AI_REPLY_REQUIRES_APPROVAL=false                 # Set on the API service env (Render backend). Not read by Next.js. true = draft in inbox; guest receives reply only after approve.
# Local dev: Resend cannot POST to localhost — use ngrok/cloudflared and set webhook URL to https://<tunnel>/api/v1/webhooks/resend

# Knowledge base: POST /knowledge-base/:id/dev/clear-all is allowed when NODE_ENV=development, or when KB_DEV_ALLOW_CLEAR=true (staging only)
# KB_DEV_ALLOW_CLEAR=true

# Neon DB (production example — copy to .env)
# DATABASE_URL="postgresql://user:pass@ep-name-pooler.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 (private bucket; downloads via GET /api/v1/messages/attachments/:id/download → presigned URL)
# Omit all R2_* below for local dev without uploads.
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_access_key"
# R2_SECRET_ACCESS_KEY="your_secret_key"
# R2_BUCKET_NAME="rentai-attachments"
# R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
# Path-style S3 URLs (default true). If PutObject returns AccessDenied, confirm API token has Object Read & Write on this bucket.
# R2_FORCE_PATH_STYLE="true"
