# Copy to .env.local.
# REST: Next proxies /api/v1 → Nest (API_URL / NEXT_PUBLIC_API_URL).
# Socket.IO: connects directly to the Nest origin (NEXT_PUBLIC_API_URL). Do not rely on Next to proxy WebSockets.
# Optional: NEXT_PUBLIC_WS_URL=wss://api.example.com — only if the WS endpoint origin differs from NEXT_PUBLIC_API_URL.
# Server-side proxy: API_URL (preferred) or NEXT_PUBLIC_API_URL; use 127.0.0.1 on Windows if localhost → IPv6 breaks.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3010
# API_URL=http://127.0.0.1:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3012
# Show "Clear KB (dev)" on property → Knowledge base (needs backend KB_DEV_ALLOW_CLEAR=true if not NODE_ENV=development).
# NEXT_PUBLIC_KB_DEV_CLEAR=true

# Temporary: sidebar only allows Dashboard, Properties, Tasks, Chat; other items stay visible but inactive (native aria-disabled).
# NEXT_PUBLIC_NAV_LIMITED_MODE=true
