# Copy to .env.local. Next (e.g. :3012) proxies /api → Nest; Socket.IO uses the same origin as the page.
# Optional: NEXT_PUBLIC_SOCKET_SAME_ORIGIN=true — force same-origin (overrides NEXT_PUBLIC_WS_URL).
# Avoid NEXT_PUBLIC_WS_URL=http://localhost:3010 when the app is on another port — use same-origin + proxy.
# Server proxy reads API_URL first (can point to 127.0.0.1 on Windows if localhost:3010 fails).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3010
# API_URL=http://127.0.0.1:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3012
