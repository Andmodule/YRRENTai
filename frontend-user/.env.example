# Copy to .env.local. Next dev (e.g. :3012) proxies /api → Nest.
# Do NOT set NEXT_PUBLIC_WS_URL to http://localhost:3010 while the app runs on :3012 — Socket.IO would
# bypass the proxy and fail; see src/lib/socket/client.ts (dev uses same origin automatically).
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3012
