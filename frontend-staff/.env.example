# Copy to .env.local for local dev.
# Nest API (pnpm dev:backend). On Windows prefer 127.0.0.1 if localhost does not reach the server.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3010

# Production: public HTTPS URL of this app. Backend TELEGRAM_STAFF_MINI_APP_URL should match this origin.
# NEXT_PUBLIC_SITE_URL=https://staff.example.com

# Optional: Socket.IO if it must differ from REST origin
# NEXT_PUBLIC_WS_URL=
